<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_f8"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.audio_player.AudioPlayerFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/song_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/audioAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_f8"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:outlineProvider="bounds"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/song_list">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/audioCollapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="@android:color/transparent"
            app:titleEnabled="false">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="64dp"
                android:orientation="vertical"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.45">

                <View
                    android:id="@+id/audioHeaderScrim"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0"
                    android:background="@drawable/top_status_scrim" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/audioLargeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="@string/audio_player"
                    android:textColor="@color/black_text_color"
                    android:textSize="32sp" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/player_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/back_white_r_18"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="16dp"
                    android:visibility="invisible">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/playerStatusLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/open_sans_bold"
                            android:text="@string/audio_now_playing"
                            android:textColor="@color/orange"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/buttonFavoriteCurrent"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_margin="5dp"
                            android:background="@drawable/back_white_r_24"
                            android:elevation="2dp"
                            android:padding="8dp"
                            android:src="@drawable/icon_heart_outline" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <FrameLayout
                        android:layout_width="132dp"
                        android:layout_height="132dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/back_orange_r_18"
                        android:elevation="4dp"
                        android:padding="4dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/song_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/back_white_r_18"
                            app:shapeAppearanceOverlay="@style/RoundedImage_18"
                            android:scaleType="centerCrop"
                            android:visibility="invisible" />
                    </FrameLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/open_sans_condensed_extra_bold"
                        android:gravity="center"
                        android:lines="1"
                        android:textColor="@color/orange"
                        android:textSize="20sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/artist_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/open_sans_medium"
                        android:gravity="center"
                        android:lines="1"
                        android:textColor="@color/black_text_color"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/seek_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:progressDrawable="@drawable/progress_drawable_1"
                        android:splitTrack="false"
                        android:thumb="@drawable/slider" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/audioTimeRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/currentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans_medium"
                            android:text="0:00"
                            android:textColor="@color/black_text_color"
                            android:textSize="12sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/totalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans_medium"
                            android:text="0:00"
                            android:textColor="@color/black_text_color"
                            android:textSize="12sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/player_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="2dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/button_previous"
                            android:layout_width="38dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:layout_margin="10dp"
                            android:background="@drawable/sel_b_r_21"
                            android:elevation="8dp"
                            android:padding="9dp"
                            android:src="@drawable/icon_previous" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/button_play"
                            android:layout_width="60dp"
                            android:layout_height="74dp"
                            android:layout_margin="10dp"
                            android:background="@drawable/sel_b_r_30_orange"
                            android:elevation="6dp"
                            android:padding="12dp"
                            android:src="@drawable/icon_play_big" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/button_next"
                            android:layout_width="38dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:layout_margin="10dp"
                            android:background="@drawable/sel_b_r_21"
                            android:elevation="8dp"
                            android:padding="9dp"
                            android:src="@drawable/icon_next" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/buttonGrantAudioAccess"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/back_orange_r_24"
                        android:fontFamily="@font/open_sans_bold"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/grant_audio_permission"
                        android:textColor="@color/white_f8"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/buttonRefreshAudioList"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/back_orange_r_24"
                        android:fontFamily="@font/open_sans_bold"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/refresh_audio_list"
                        android:textColor="@color/white_f8"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/audioHeaderToolbar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_collapseMode="pin">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/audioMenuButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/sel_b_menu"
                    android:elevation="10dp"
                    android:padding="9dp"
                    android:src="@drawable/icon_menu" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/audioCompactTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:alpha="0"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="@string/audio_player"
                    android:textColor="@color/black_text_color"
                    android:textSize="20sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <HorizontalScrollView
            android:id="@+id/audioFilterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:scrollbars="none"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/audioFilterRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipAudioAll"
                    style="@style/HistoryPeriodChip"
                    android:text="@string/audio_filter_all" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipAudioFavorites"
                    style="@style/HistoryPeriodChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/audio_filter_favorites" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipAudioDownloads"
                    style="@style/HistoryPeriodChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/audio_filter_downloads" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipAudioMusic"
                    style="@style/HistoryPeriodChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/audio_filter_music" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipAudioRecordings"
                    style="@style/HistoryPeriodChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/audio_filter_recordings" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipAudioRecent"
                    style="@style/HistoryPeriodChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/audio_filter_recent" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </HorizontalScrollView>

    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/audioAppBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0"
        android:background="#14000000"
        android:importantForAccessibility="no"
        app:layout_anchor="@id/audioAppBar"
        app:layout_anchorGravity="bottom" />


    <View
        android:id="@+id/bottom_content_scrim"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_content_scrim"
        android:clickable="false"
        android:focusable="false" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>