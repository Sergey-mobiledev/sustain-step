<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_f8"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.history.HistoryFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/historyAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_f8"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:outlineProvider="bounds"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/rvHistory">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/historyCollapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="@android:color/transparent"
            app:titleEnabled="false">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="64dp"
                android:orientation="vertical"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.45">

                <View
                    android:id="@+id/historyHeaderScrim"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0"
                    android:background="@drawable/top_status_scrim" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/historyLargeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="@string/completed_tasks"
                    android:textColor="@color/black_text_color"
                    android:textSize="32sp" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/historySummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/back_white_r_18"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/historySummaryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_bold"
                        android:text="@string/history_summary_title_today"
                        android:textColor="@color/orange"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/historySummarySteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/black_text_color"
                        android:textSize="24sp" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/historySummaryDistance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/open_sans_medium"
                            android:textColor="@color/black_text_color"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/historySummaryCalories"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/open_sans_medium"
                            android:gravity="end"
                            android:textColor="@color/black_text_color"
                            android:textSize="13sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/historySummaryAverage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:textColor="@color/black_text_color"
                        android:textSize="13sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/historyHeaderToolbar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_collapseMode="pin">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/historyMenuButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/sel_b_menu"
                    android:elevation="10dp"
                    android:layout_marginStart="20dp"
                    android:padding="9dp"
                    android:src="@drawable/icon_menu" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/historyCompactTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:alpha="0"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="@string/completed_tasks"
                    android:textColor="@color/black_text_color"
                    android:textSize="20sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <HorizontalScrollView
            android:id="@+id/historyChipScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:scrollbars="none"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/historyChipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipDay"
                    style="@style/HistoryPeriodChip"
                    android:text="@string/history_period_day" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipWeek"
                    style="@style/HistoryPeriodChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/history_period_week" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipMonth"
                    style="@style/HistoryPeriodChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/history_period_month" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chipAll"
                    style="@style/HistoryPeriodChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/history_period_all" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </HorizontalScrollView>

    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/historyAppBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0"
        android:background="#14000000"
        android:importantForAccessibility="no"
        app:layout_anchor="@id/historyAppBar"
        app:layout_anchorGravity="bottom" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/open_sans_bold"
        android:text="@string/no_data_yet"
        android:textColor="@color/black_text_color"
        android:textSize="16sp"
        android:visibility="gone" />

    <View
        android:id="@+id/bottom_content_scrim"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_content_scrim"
        android:clickable="false"
        android:focusable="false" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
